# This subproject has its own venv, separate from the repo root's: enoslib's
# `rich ~= 12.0` pin cannot coexist with the main venv's xdsl[dev].
#
# The root .envrc exports UV_PROJECT_ENVIRONMENT=<repo>/.venv, and direnv
# applies that to subdirectories too, so uv would otherwise install enoslib
# straight into the main venv. Point it here instead. No `use flake`: these
# queries are plain Python over the Grid'5000 API and need no toolchain.
export UV_PROJECT_ENVIRONMENT="$PWD/.venv"
export VIRTUAL_ENV="$UV_PROJECT_ENVIRONMENT"
PATH_add "$UV_PROJECT_ENVIRONMENT/bin"
